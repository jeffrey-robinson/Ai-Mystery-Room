# Required for AI-generated cases. Keep this value on the server only.
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Without this, cases are held in memory until the server restarts.
# Copy the URI from MongoDB Atlas and URL-encode special characters in the password.
MONGODB_URI=
PORT=3001
